# Đường dẫn gọn cho Hostinger (Apache / LiteSpeed)
#   spinlab.vn/            -> chuyển tới /trangchu
#   spinlab.vn/trangchu    -> index.html
#   spinlab.vn/xe-road     -> xe-road.html
#   spinlab.vn/xe-road.html -> chuyển (301) tới /xe-road
Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On

# Không công khai công cụ nội bộ và dữ liệu git
RewriteRule ^(tools|data|\.git)(/|$) - [F,L]
RewriteRule \.(command|py|md)$ - [F,L]

# Trang chủ
RewriteRule ^$ /trangchu [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^ /trangchu [R=301,L]
RewriteRule ^trangchu/?$ index.html [L]

# Trang đã đổi tên
RewriteRule ^su-kien/?$ /tin-tuc [R=301,L]

# Tiếng Anh: /en/home, /en/road-bikes -> en/*.html
RewriteRule ^en/?$ /en/home [R=301,L]
RewriteRule ^en/trangchu/?$ /en/home [R=301,L]
RewriteCond %{THE_REQUEST} \s/+en/([a-z0-9-]+)\.html[\s?]
RewriteRule ^ /en/%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/en/$1.html -f
RewriteRule ^en/([a-z0-9-]+)/?$ en/$1.html [L]

# Link cũ .html -> link gọn
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Link gọn -> file .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]
