{"product":{"id":10234591904032,"title":"Zaffiro EVO","body_html":"\u003cp\u003e\u003cstrong\u003eThe all-conditions road training tire.\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003eFor the long miles of endurance cycling, early-season training, and road touring, durability and reliability are what matter most. Zaffiro EVO delivers on both.\u003c\/p\u003e\n\u003cp\u003eIt provides the confidence and proven performance you need to keep going, ride after ride. As a durable road bike tire designed for everyday use, it combines reliability, puncture resistance, and consistent performance in all conditions. Zaffiro Evo is inspired by WorldTour-proven technology, adapting race-derived performance to real-world roads. Take on rough chip seal, potholes, and unpredictable weather with ease.\u003c\/p\u003e\n\u003cp\u003eWhether you're logging base miles or commuting through changing conditions, Zaffiro EVO transforms daily road challenges into smooth, controlled performance. A reliable road bike tire built to last, it proves its value every time the road gets tough.\u003c\/p\u003e","vendor":"Vittoria","product_type":"Road Tire","created_at":"2026-03-12T22:27:59-05:00","handle":"zaffiro-evo","updated_at":"2026-10-19T23:44:54-05:00","published_at":"2026-05-07T07:08:35-05:00","template_suffix":null,"published_scope":"global","tags":"Discounted products, EP70, IPP40, Road, Sitewide, Tires, Training","variants":[{"id":51339662950688,"product_id":10234591904032,"title":"700x23c \/ Black","price":"48.99","sku":"11A00938","position":1,"compare_at_price":"","fulfillment_service":"manual","inventory_management":"shopify","option1":"700x23c","option2":"Black","option3":null,"created_at":"2026-03-12T22:28:00-05:00","updated_at":"2026-10-19T23:44:54-05:00","taxable":true,"barcode":"8022530037365","grams":230,"image_id":52051225739552,"weight":230.0,"weight_unit":"g","tax_code":"","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"USD","compar