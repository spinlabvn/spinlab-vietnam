{"product":{"id":10065157226784,"title":"Terreno XC Trail","body_html":"\u003cp\u003e\u003cstrong\u003eThe hardpack trail rocket.\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003eWhen the trail you ride is hardpack and speed is everything, Terreno XC Trail delivers. Its fast-rolling fish scale center tread flies on smooth, dry terrain, while reliable braking and cornering grip keep you in command when the pace intensifies. A gradual transition from center strip to shoulder knobs means every turn feels fluid and predictable.\u003c\/p\u003e\n\u003cp\u003ePerformance goes even deeper with Vittoria’s 4Compound Formulation, which strategically places four optimized rubber compounds exactly where they’re needed. The result is an unrivaled fusion of speed, grip, and durability.\u003c\/p\u003e\n\u003cp\u003eBuilt on our advanced Trail casing, this tire balances low weight with toughness: a tubeless-ready nylon construction reinforced with sidewall protection and an anti-puncture belt—confidence for every line you choose.\u003c\/p\u003e","vendor":"Vittoria","product_type":"MTB Tire","created_at":"2025-10-02T21:14:09-05:00","handle":"terreno-xc-trail","updated_at":"2026-10-13T09:08:29-05:00","published_at":"2025-11-18T09:05:54-06:00","template_suffix":"xc-trail-template","published_scope":"global","tags":"Cross Country, Discounted products, EP70, IPP40, MTB, Sitewide, Tires, Trail Case, XC\/Down Country","variants":[{"id":50758679331104,"product_id":10065157226784,"title":"29x2.1 \/ Black","price":"96.99","sku":"11A00745","position":1,"compare_at_price":"","fulfillment_service":"manual","inventory_management":"shopify","option1":"29x2.1","option2":"Black","option3":null,"created_at":"2025-10-02T21:14:09-05:00","updated_at":"2026-10-13T09:08:29-05:00","taxable":true,"barcode":"8022530035972","grams":780,"image_id":50972854059296,"weight":780.0,"weight_unit":"g","tax_code":"","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"USD","com